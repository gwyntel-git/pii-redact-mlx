PYPI_OPENPIPE_TOKEN=placeholder

# oMLX (MLX) backend defaults — see README
# OMLX_BASE_URL=http://localhost:8000/v1

# Prefer pointing at a key FILE over inlining the secret, so it stays out of
# shell history and process listings. The file should contain only the key:
#   printf '%s' "$KEY" > ~/.omlx/api_key && chmod 600 ~/.omlx/api_key
# OMLX_API_KEY_FILE=~/.omlx/api_key

# Alternatively, an inline key (less preferred):
# OMLX_API_KEY=

# PII_REDACT_BACKEND=auto
# PII_REDACT_CONCURRENCY=8
